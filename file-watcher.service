[Unit]
Description=File Watcher - monitors directories and moves matching files
Documentation=file://%h/Source/file-watcher/README.md
After=default.target

[Service]
Type=simple
# Uses config file for multiple watches - edit ~/.config/file-watcher/config to customize
ExecStart=%h/Source/file-watcher/file-watcher.fish --config %h/.config/file-watcher/config
Restart=on-failure
RestartSec=5

# Logging goes to journald by default (view with: journalctl --user -u file-watcher)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
