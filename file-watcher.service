[Unit]
Description=File Watcher User Service
Documentation=https://github.com/fred/file-watcher
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/file-watcher --config %h/.config/file-watcher/file-watcher.conf --log-file %h/.local/state/file-watcher/file-watcher.log
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
