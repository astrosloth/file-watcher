# Set default behavior to normalize line endings to LF for all text files
* text=auto eol=lf

# Force specific file types to use LF
*.go text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.fish text eol=lf
*.ps1 text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.service text eol=lf
go.mod text eol=lf
go.sum text eol=lf
